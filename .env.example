# ---- Database (PostgreSQL) ----
# Local: postgresql://postgres:postgres@localhost:5432/poewatch
# Neon/Supabase: copy the pooled connection string here
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/poewatch?schema=public"

# ---- Redis (Upstash or local) ----
# Local: redis://localhost:6379
REDIS_URL="redis://localhost:6379"

# ---- POE2 Trade API ----
# League name as it appears in the trade site URL, e.g. "Standard" or the current challenge league.
POE_LEAGUE="Standard"
# A descriptive User-Agent is REQUIRED by GGG. Include contact info.
POE_USER_AGENT="poewatch/0.1 (+https://github.com/mhoo999/poewatch) contact: you@example.com"
# Optional: a valid POESESSID cookie value. Some trade endpoints are gated behind
# Cloudflare and require an authenticated session. Leave empty to try unauthenticated first.
POESESSID=""
