# ---- Database (PostgreSQL) ----
# Local: postgresql://postgres:postgres@localhost:5432/poewatch
# Neon: copy the POOLED connection string here (host contains "-pooler"), keep ?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/poewatch?schema=public"
# Neon: the DIRECT (non-pooled) connection string, used by `prisma migrate deploy`.
# For local Postgres you can set it to the same value as DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/poewatch?schema=public"

# ---- Redis (Upstash or local) ----
# Local: redis://localhost:6379
REDIS_URL="redis://localhost:6379"

# ---- poe.ninja ingestion + Vercel Cron ----
# Secret shared with the cron route; Vercel sends it as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=""
# Optional override for the poe.ninja base URL (rarely needed).
POENINJA_BASE="https://poe.ninja"

# ---- POE2 Trade API ----
# League name as it appears in the trade site URL, e.g. "Standard" or the current challenge league.
POE_LEAGUE="Standard"
# A descriptive User-Agent is REQUIRED by GGG. Include contact info.
POE_USER_AGENT="poewatch/0.1 (+https://github.com/mhoo999/poewatch) contact: you@example.com"
# Optional: a valid POESESSID cookie value. Some trade endpoints are gated behind
# Cloudflare and require an authenticated session. Leave empty to try unauthenticated first.
POESESSID=""
